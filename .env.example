# ---------------------------------------------------------------------------
# Modèle de configuration locale.
# Copier en `.env` puis renseigner les valeurs réelles :
#   cp .env.example .env
# Le fichier `.env` est ignoré par Git. Ne jamais y committer de secret.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# development | production
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Clé de signature Flask (jetons, sessions). Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# --- Site public -----------------------------------------------------------
SITE_URL=http://localhost:4321
SITE_NAME=Mohamed Hosayni
SITE_DEFAULT_LOCALE=fr
# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
CORS_ORIGINS=http://localhost:4321,https://hosayni.com

# --- API Flask -------------------------------------------------------------
API_PORT=8000
# Formulaire de contact. En développement, true avec MAIL_SUPPRESS_SEND=true
# journalise les messages sans SMTP. Passer à false pour masquer le formulaire
# et faire répondre 503 à /api/contact sans configurer de serveur mail.
CONTACT_ENABLED=true
# Format Flask-Limiter : "<nombre> per <heure|minute|day>"
CONTACT_RATE_LIMIT=5 per hour
# Stockage du rate limiting : memory:// en local et sur un seul processus.
# Utiliser redis://... dès que l'API tourne avec plusieurs workers/instances.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=true
# À activer uniquement derrière Caddy/nginx, pour lire l'IP réelle via
# X-Forwarded-For. Sans cela, tous les visiteurs partagent le même quota.
TRUST_PROXY=false
# Cible du proxy Vite en développement (Astro relaie /api vers Flask).
API_PROXY_TARGET=http://localhost:8000

# --- GitHub (projets dynamiques) ------------------------------------------
GITHUB_USERNAME=hosayni
# Token en lecture seule (fine-grained, scope public) — optionnel en local,
# recommandé en production pour éviter la limite de 60 requêtes/heure.
GITHUB_TOKEN=
# Durée du cache des dépôts, en secondes (1 h par défaut).
GITHUB_CACHE_TTL=3600
# Nombre maximal de dépôts affichés, et liste blanche optionnelle
# (noms séparés par des virgules, dans l'ordre d'affichage).
GITHUB_MAX_REPOS=6
GITHUB_REPOS=
# Délai maximal des appels sortants vers GitHub, en secondes.
GITHUB_HTTP_TIMEOUT=5

# --- SMTP (formulaire de contact) -----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT=10
SMTP_FROM=no-reply@hosayni.com
CONTACT_TO=hosayni92@gmail.com
# En développement, true par défaut : l'e-mail est journalisé, pas envoyé.
# Forcer false pour tester un vrai serveur SMTP. Interdit en production.
MAIL_SUPPRESS_SEND=true

# --- Analytics respectueux de la vie privée (optionnel) -------------------
# Laisser vide pour désactiver complètement le script.
PUBLIC_PLAUSIBLE_DOMAIN=
