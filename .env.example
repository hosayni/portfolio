# ---------------------------------------------------------------------------
# Modèle de configuration locale.
# Copier en `.env` puis renseigner les valeurs réelles :
#   cp .env.example .env
# Le fichier `.env` est ignoré par Git. Ne jamais y committer de secret.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# development | production
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Clé de signature Flask (jetons, sessions). Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# --- Site public -----------------------------------------------------------
SITE_URL=http://localhost:4321
SITE_NAME=Mohamed Hosayni
SITE_DEFAULT_LOCALE=fr
# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
CORS_ORIGINS=http://localhost:4321,https://hosayni.com

# --- API Flask -------------------------------------------------------------
API_PORT=8000
# Format Flask-Limiter : "<nombre> per <heure|minute|day>"
CONTACT_RATE_LIMIT=5 per hour

# --- GitHub (projets dynamiques) ------------------------------------------
GITHUB_USERNAME=hosayni
# Token en lecture seule (fine-grained, scope public) — optionnel en local,
# recommandé en production pour éviter la limite de 60 requêtes/heure.
GITHUB_TOKEN=
# Durée du cache des dépôts, en secondes (1 h par défaut).
GITHUB_CACHE_TTL=3600

# --- SMTP (formulaire de contact) -----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=no-reply@hosayni.com
CONTACT_TO=hosayni92@gmail.com

# --- Analytics respectueux de la vie privée (optionnel) -------------------
# Laisser vide pour désactiver complètement le script.
PUBLIC_PLAUSIBLE_DOMAIN=
