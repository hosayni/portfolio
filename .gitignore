# ---------------------------------------------------------------------------
# Système et éditeurs
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~

.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------------------------------------------------------------------------
# Secrets et environnement
# Le fichier .env.example est volontairement versionné : il documente
# les variables attendues, jamais leurs valeurs réelles.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# ---------------------------------------------------------------------------
# Node / Astro
# ---------------------------------------------------------------------------
node_modules/
dist/
.astro/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rapports de tests et de qualité
coverage/
playwright-report/
test-results/
blob-report/
lighthouse/
.lighthouseci/

# ---------------------------------------------------------------------------
# Python / Flask
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/

# ---------------------------------------------------------------------------
# Divers
# ---------------------------------------------------------------------------
*.log
tmp/
.cache/
