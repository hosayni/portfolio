# ---------------------------------------------------------------------------
# Configuration de PRODUCTION (VPS).
# Copier ce fichier en deploy/.env, puis :
#   chmod 600 deploy/.env
# Ne jamais committer deploy/.env ni y laisser les valeurs d'exemple.
# ---------------------------------------------------------------------------

# --- Domaine et TLS (Caddy) ------------------------------------------------
SITE_DOMAIN=example.com
WWW_DOMAIN=www.example.com
ACME_EMAIL=admin@example.com

# --- Images publiées par la CI --------------------------------------------
GHCR_OWNER=hosayni
IMAGE_TAG=latest

# --- Application -----------------------------------------------------------
APP_ENV=production
APP_VERSION=0.1.0
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

SITE_URL=https://example.com
SITE_NAME=Mohamed Hosayni
SITE_DEFAULT_LOCALE=fr
CORS_ORIGINS=https://example.com,https://www.example.com

# --- API Flask -------------------------------------------------------------
CONTACT_RATE_LIMIT=5 per hour
# Formulaire de contact désactivé par défaut : aucun SMTP n'est requis pour le
# premier déploiement. Passer à true et renseigner SMTP_* pour l'activer.
CONTACT_ENABLED=false
# Un seul worker Gunicorn : le stockage mémoire est cohérent. Pour scaler,
# installer Redis et utiliser redis://redis:6379/0.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=true
TRUST_PROXY=true

# --- GitHub (projets dynamiques) ------------------------------------------
GITHUB_USERNAME=hosayni
GITHUB_TOKEN=
GITHUB_CACHE_TTL=3600
GITHUB_MAX_REPOS=6
GITHUB_REPOS=
GITHUB_HTTP_TIMEOUT=5

# --- SMTP (formulaire de contact) -----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT=10
SMTP_FROM=no-reply@example.com
CONTACT_TO=contact@example.com
# Obligatoire à false en production : la factory refuse de démarrer sinon.
MAIL_SUPPRESS_SEND=false
