{
  "name": "portfolio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site public du portfolio — Astro 5, TypeScript strict, Tailwind CSS 4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
