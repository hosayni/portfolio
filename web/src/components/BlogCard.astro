---
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import { entrySlug, type BlogEntry } from '@/lib/content';
import { formatDate, readingTime } from '@/lib/format';

interface Props {
  post: BlogEntry;
  lang: Lang;
  index?: number;
}

const { post, lang, index = 0 } = Astro.props;
const t = useTranslations(lang);
const { data } = post;
const href = localizePath(lang, `/blog/${entrySlug(post.id)}/`);
const minutes = readingTime(post.body);
---

<article class="card h-full" data-reveal style={`transition-delay: ${index * 80}ms`}>
  <div class="flex items-start justify-between gap-4">
    <p class="font-mono text-[0.68rem] tracking-[0.14em] text-muted uppercase">
      <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, lang)}</time>
    </p>
    <span class="card-arrow text-muted" aria-hidden="true">
      ↗
    </span>
  </div>

  <h3 class="text-h3 font-semibold">
    <a
      href={href}
      class="after:absolute after:inset-0 after:content-[''] hover:underline hover:decoration-1"
    >
      {data.title}
    </a>
  </h3>

  <p class="text-sm leading-relaxed text-muted">{data.description}</p>

  <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-2">
    <ul class="flex flex-wrap gap-2" aria-label={t('blog.tags')}>
      {data.tags.map((tag) => (
        <li class="tag">{tag}</li>
      ))}
    </ul>
    <span class="font-mono text-[0.68rem] text-muted">
      {minutes} {t('blog.readingTime')}
    </span>
  </div>
</article>
