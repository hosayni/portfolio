---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="container-page pt-16 pb-10 md:pt-24">
  <p class="eyebrow" data-reveal>
    {eyebrow}
  </p>
  <h1 class="mt-5 max-w-[20ch] text-h2 font-semibold" data-reveal>
    {title}
  </h1>
  {lead && (
    <p class="mt-6 max-w-[65ch] text-lead text-muted" data-reveal>
      {lead}
    </p>
  )}
</header>
