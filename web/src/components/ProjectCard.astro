---
import type { ProjectTeaser } from '@/data/projects';
import type { Lang } from '@/i18n/ui';
import { localizePath } from '@/i18n/utils';

interface Props {
  project: ProjectTeaser;
  lang: Lang;
  index?: number;
}

const { project, lang, index = 0 } = Astro.props;
const href = localizePath(lang, '/projets/');
---

<article class="card h-full" data-reveal style={`transition-delay: ${index * 80}ms`}>
  <div class="flex items-start justify-between gap-4">
    <p class="font-mono text-[0.68rem] tracking-[0.14em] text-muted uppercase">
      {project.year} · {String(index + 1).padStart(2, '0')}
    </p>
    <span class="card-arrow text-muted" aria-hidden="true">
      ↗
    </span>
  </div>

  <h3 class="text-h3 font-semibold">
    <a
      href={href}
      class="after:absolute after:inset-0 after:content-[''] hover:underline hover:decoration-1"
    >
      {project.title[lang]}
    </a>
  </h3>

  <p class="text-sm leading-relaxed text-muted">{project.summary[lang]}</p>

  <ul class="mt-auto flex flex-wrap gap-2 pt-2" aria-label="Technologies">
    {project.tags.map((tag) => (
      <li class="tag">{tag}</li>
    ))}
  </ul>
</article>
