---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { defaultLang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

const t = useTranslations(defaultLang);
const homeFr = localizePath('fr', '/');
const homeEn = localizePath('en', '/');
---

<BaseLayout
  title={t('notFound.title')}
  description={t('notFound.lead')}
  lang={defaultLang}
  noindex
  alternates={{ fr: '/fr/', en: '/en/' }}
>
  <section class="container-page flex min-h-[60vh] flex-col justify-center py-20">
    <p class="font-mono text-sm tracking-[0.2em] text-muted">404</p>
    <h1 class="mt-4 text-hero font-semibold tracking-[-0.04em]">{t('notFound.title')}</h1>
    <p class="mt-4 max-w-[55ch] text-lead text-muted">{t('notFound.lead')}</p>

    <p class="mt-3 text-sm text-muted" lang="en">
      Page not found —
      <a href={homeEn} class="underline decoration-line underline-offset-4 hover:text-ink">
        go to the English home page
      </a>
      .
    </p>

    <a class="btn mt-8 w-fit" href={homeFr}>
      {t('notFound.cta')}
      <span aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>
