---
import { getCollection, render } from 'astro:content';
import { languages, type Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { entrySlug, getAlternateSlugs } from '@/lib/content';
import { formatDate, readingTime } from '@/lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { lang: entry.data.lang, slug: entrySlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const lang = data.lang as Lang;
const t = useTranslations(lang);
const { Content, headings } = await render(entry);
const minutes = readingTime(entry.body);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const alternateSlugs = await getAlternateSlugs('blog', data.translationKey, lang);
const alternates: Partial<Record<Lang, string>> = {
  [lang]: localizePath(lang, `/blog/${entrySlug(entry.id)}/`),
};
for (const code of Object.keys(alternateSlugs) as Lang[]) {
  const slug = alternateSlugs[code];
  if (slug) alternates[code] = localizePath(code, `/blog/${slug}/`);
}

const site = Astro.site ?? new URL('https://hosayni.com');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Mohamed Hosayni' },
  url: new URL(Astro.url.pathname, site).href,
  mainEntityOfPage: new URL(Astro.url.pathname, site).href,
  keywords: data.tags.join(', '),
  inLanguage: languages[lang].htmlLang,
};

const blogHref = localizePath(lang, '/blog/');
---

<BaseLayout
  title={data.title}
  description={data.description}
  lang={lang}
  type="article"
  alternates={alternates}
  jsonLd={jsonLd}
>
  <article>
    <header class="container-page pt-10 md:pt-14">
      <a
        href={blogHref}
        class="inline-flex items-center gap-2 text-sm text-muted no-underline transition-colors hover:text-ink"
      >
        <span aria-hidden="true">←</span>
        {t('blog.back')}
      </a>

      <div class="mt-8 max-w-3xl">
        <p class="eyebrow">
          <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, lang)}</time>
          <span aria-hidden="true">·</span>
          {minutes} {t('blog.readingTime')}
        </p>
        <h1 class="mt-4 text-h2 font-semibold">{data.title}</h1>
        <p class="mt-4 text-lead text-muted">{data.description}</p>

        <ul class="mt-6 flex flex-wrap gap-2" aria-label={t('blog.tags')}>
          {data.tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>

        {data.updatedDate && (
          <p class="mt-3 text-xs text-muted">
            {t('blog.updated')}
            <time datetime={data.updatedDate.toISOString()}>
              {formatDate(data.updatedDate, lang)}
            </time>
          </p>
        )}
      </div>
    </header>

    <div class="container-page py-12 md:py-16">
      <div class="grid gap-12 lg:grid-cols-[200px_minmax(0,1fr)] lg:gap-16">
        {toc.length > 0 && (
          <aside class="self-start lg:sticky lg:top-24">
            <h2 class="eyebrow">{t('blog.toc')}</h2>
            <ol class="mt-4 grid gap-2 text-sm">
              {toc.map((heading) => (
                <li class:list={[heading.depth === 3 && 'pl-3']}>
                  <a
                    class="text-muted no-underline transition-colors hover:text-ink"
                    href={`#${heading.slug}`}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </aside>
        )}

        <div class="prose">
          <Content />
        </div>
      </div>
    </div>

    <div class="container-page pb-20 md:pb-28">
      <a
        class="inline-flex items-center gap-2 text-sm text-muted no-underline transition-colors hover:text-ink"
        href={blogHref}
      >
        <span aria-hidden="true">←</span>
        {t('blog.back')}
      </a>
    </div>
  </article>
</BaseLayout>
