---
import ComingSoon from '@/components/ComingSoon.astro';
import PageHeader from '@/components/PageHeader.astro';
import { locales, type Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t('contact.title')} description={t('contact.lead')} lang={lang}>
  <PageHeader
    eyebrow={`05 — ${t('nav.contact')}`}
    title={t('contact.title')}
    lead={t('contact.lead')}
  />
  <ComingSoon text={t('common.comingSoon')} />
</BaseLayout>
