---
import ContactForm from '@/components/ContactForm.astro';
import PageHeader from '@/components/PageHeader.astro';
import { locales, type Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const github = 'https://github.com/hosayni/';
const linkedin = 'https://www.linkedin.com/in/hosayni/';
---

<BaseLayout title={t('contact.title')} description={t('contact.lead')} lang={lang}>
  <PageHeader
    eyebrow={`05 — ${t('nav.contact')}`}
    title={t('contact.title')}
    lead={t('contact.lead')}
  />

  <section class="pb-20 md:pb-28">
    <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16">
      <div class="rounded-[20px] border border-line bg-surface p-6 md:p-8">
        <ContactForm lang={lang} />
      </div>

      <aside class="grid content-start gap-8">
        <div>
          <h2 class="eyebrow">{t('contact.direct')}</h2>
          <ul class="mt-4 grid gap-2 text-sm">
            <li>
              <a
                class="text-muted no-underline transition-colors hover:text-ink"
                href="mailto:hosayni92@gmail.com"
              >
                hosayni92@gmail.com
              </a>
            </li>
            <li>
              <a
                class="inline-flex items-center gap-1.5 text-muted no-underline transition-colors hover:text-ink"
                href={github}
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub<span class="sr-only"> {t('a11y.external')}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a
                class="inline-flex items-center gap-1.5 text-muted no-underline transition-colors hover:text-ink"
                href={linkedin}
                target="_blank"
                rel="noopener noreferrer"
              >
                LinkedIn<span class="sr-only"> {t('a11y.external')}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="eyebrow">{t('hero.availability')}</h2>
          <p class="mt-4 flex items-start gap-2 text-sm text-muted">
            <span class="status-dot mt-2 shrink-0" aria-hidden="true"></span>
            <span>{t('home.contact.lead')}</span>
          </p>
        </div>

        <div>
          <h2 class="eyebrow">{t('hero.locationLabel')}</h2>
          <p class="mt-4 text-sm text-muted">{t('hero.location')}</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
