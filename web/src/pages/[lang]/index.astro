---
import ProjectCard from '@/components/ProjectCard.astro';
import { featuredProjects } from '@/data/projects';
import { locales, type Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const projectsHref = localizePath(lang, '/projets/');
const contactHref = localizePath(lang, '/contact/');

const site = Astro.site ?? new URL('https://hosayni.com');
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: t('site.name'),
  url: new URL(localizePath(lang, '/'), site).href,
  email: 'mailto:hosayni92@gmail.com',
  jobTitle: t('site.role'),
  sameAs: ['https://github.com/hosayni/', 'https://www.linkedin.com/in/hosayni/'],
};
---

<BaseLayout
  title={t('site.name')}
  description={t('home.meta.description')}
  lang={lang}
  jsonLd={personJsonLd}
>
  <!-- Hero ---------------------------------------------------------------- -->
  <section class="pt-14 pb-14 md:pt-20 md:pb-20">
    <div class="container-page grid gap-12 lg:grid-cols-[1.35fr_0.9fr] lg:items-center lg:gap-16">
      <div>
        <p class="eyebrow" data-reveal>
          {t('hero.eyebrow')}
        </p>
        <h1 class="mt-6 text-hero font-semibold tracking-[-0.04em]" data-reveal>
          {t('hero.title')}
        </h1>
        <p class="mt-6 max-w-[58ch] text-lead text-muted" data-reveal>
          {t('hero.lead')}
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal>
          <a class="btn" href={projectsHref}>
            {t('hero.ctaProjects')}
            <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href={contactHref}>
            {t('hero.ctaContact')}
          </a>
        </div>

        <p class="mt-5 text-sm" data-reveal>
          <a
            href="/cv.pdf"
            download
            class="inline-flex items-center gap-1.5 text-muted underline decoration-line underline-offset-4 transition-colors hover:text-ink"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3v12"></path>
              <path d="m7 10 5 5 5-5"></path>
              <path d="M5 21h14"></path>
            </svg>
            {t('hero.ctaCv')}
          </a>
        </p>
      </div>

      <div data-reveal style="transition-delay: 120ms">
        <figure class="portrait">
          <div class="portrait__frame">
            <span class="portrait__monogram" aria-hidden="true">
              MH
            </span>
          </div>
          <figcaption class="portrait__note">{t('hero.portraitNote')}</figcaption>
        </figure>
        <p class="mt-4 flex items-center gap-2 text-sm text-muted">
          <span class="status-dot" aria-hidden="true"></span>
          {t('hero.availability')}
        </p>
      </div>
    </div>
  </section>

  <!-- Repères ------------------------------------------------------------- -->
  <div class="container-page">
    <dl class="grid gap-6 border-y border-line py-6 sm:grid-cols-3 sm:gap-10">
      <div>
        <dt class="font-mono text-[0.66rem] tracking-[0.16em] text-muted uppercase">
          {t('hero.focusLabel')}
        </dt>
        <dd class="mt-1 text-sm">{t('hero.focus')}</dd>
      </div>
      <div>
        <dt class="font-mono text-[0.66rem] tracking-[0.16em] text-muted uppercase">
          {t('hero.locationLabel')}
        </dt>
        <dd class="mt-1 text-sm">{t('hero.location')}</dd>
      </div>
      <div>
        <dt class="font-mono text-[0.66rem] tracking-[0.16em] text-muted uppercase">
          {t('hero.stackLabel')}
        </dt>
        <dd class="mt-1 font-mono text-sm">{t('hero.stack')}</dd>
      </div>
    </dl>
  </div>

  <!-- Projets ------------------------------------------------------------- -->
  <section class="section">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="eyebrow" data-reveal>
            {t('home.projects.eyebrow')}
          </p>
          <h2 class="mt-4 text-h2 font-semibold" data-reveal>
            {t('home.projects.title')}
          </h2>
          <p class="mt-4 text-lead text-muted" data-reveal>
            {t('home.projects.lead')}
          </p>
        </div>
        <a class="btn btn--ghost" href={projectsHref} data-reveal>
          {t('home.projects.all')}
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {featuredProjects.map((project, index) => (
          <ProjectCard project={project} lang={lang} index={index} />
        ))}
      </div>
    </div>
  </section>

  <!-- Approche ------------------------------------------------------------ -->
  <section class="section border-y border-line bg-surface">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal>
          {t('home.approach.eyebrow')}
        </p>
        <h2 class="mt-4 text-h2 font-semibold" data-reveal>
          {t('home.approach.title')}
        </h2>
        <p class="mt-4 text-lead text-muted" data-reveal>
          {t('home.approach.lead')}
        </p>
      </div>

      <ol class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
        {(
          [
            ['approach.design.title', 'approach.design.desc'],
            ['approach.build.title', 'approach.build.desc'],
            ['approach.operate.title', 'approach.operate.desc'],
          ] as const
        ).map(([titleKey, descKey], index) => (
          <li
            class="border-t border-line pt-5"
            data-reveal
            style={`transition-delay: ${index * 80}ms`}
          >
            <span class="font-mono text-xs tracking-[0.14em] text-accent">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-h3 font-semibold">{t(titleKey)}</h3>
            <p class="mt-2 max-w-[42ch] text-sm leading-relaxed text-muted">{t(descKey)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Contact ------------------------------------------------------------- -->
  <section class="container-page py-16 md:py-24">
    <div class="rounded-[20px] border border-line bg-surface p-8 md:p-12" data-reveal>
      <p class="eyebrow">{t('home.contact.eyebrow')}</p>
      <h2 class="mt-4 max-w-[22ch] text-h2 font-semibold">{t('home.contact.title')}</h2>
      <p class="mt-4 max-w-[55ch] text-muted">{t('home.contact.lead')}</p>
      <a class="btn mt-7" href="mailto:hosayni92@gmail.com">
        {t('home.contact.cta')}
      </a>
    </div>
  </section>
</BaseLayout>
