---
import ArchitectureDiagram from '@/components/ArchitectureDiagram.astro';
import PageHeader from '@/components/PageHeader.astro';
import { locales, type Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const copy = (fr: string, en: string) => (lang === 'fr' ? fr : en);

const layers = [
  {
    title: copy('Bordure', 'Edge'),
    items: [
      copy('Caddy : TLS automatique, HTTP/2 et HTTP/3', 'Caddy: automatic TLS, HTTP/2 and HTTP/3'),
      copy('Redirection 301 de / vers /fr/', '301 redirect from / to /fr/'),
      copy('En-têtes de sécurité et compression', 'Security headers and compression'),
    ],
  },
  {
    title: copy('Site statique', 'Static site'),
    items: [
      copy('Astro 5, build immuable', 'Astro 5, immutable build'),
      copy('nginx : fichiers et page 404', 'nginx: files and 404 page'),
      copy('Aucun port applicatif exposé', 'No application port exposed'),
    ],
  },
  {
    title: copy('API', 'API'),
    items: [
      copy('Flask + Gunicorn', 'Flask + Gunicorn'),
      copy('Validation, honeypot, limitation de débit', 'Validation, honeypot, rate limiting'),
      copy('Envoi SMTP et réponses JSON', 'SMTP delivery and JSON responses'),
    ],
  },
  {
    title: copy('Données et supervision', 'Data and monitoring'),
    items: [
      copy('PostgreSQL pour les messages', 'PostgreSQL for messages'),
      copy('Sauvegardes et migrations versionnées', 'Backups and versioned migrations'),
      copy('Uptime Kuma et journaux', 'Uptime Kuma and logs'),
    ],
  },
];

const pipeline = [
  {
    phase: copy('CI', 'CI'),
    title: copy('Vérifier', 'Verify'),
    description: copy(
      'Lint, format, types et tests sur chaque pull request.',
      'Lint, format, types and tests on every pull request.',
    ),
    tools: ['ESLint', 'Prettier', 'astro check', 'Ruff', 'Pytest'],
  },
  {
    phase: copy('CI', 'CI'),
    title: copy('Construire', 'Build'),
    description: copy(
      'Build Astro et images Docker multi-étapes, sans secret dans la couche finale.',
      'Astro build and multi-stage Docker images, with no secret in the final layer.',
    ),
    tools: ['Astro', 'Docker', 'Buildx'],
  },
  {
    phase: copy('CI', 'CI'),
    title: copy('Publier', 'Publish'),
    description: copy(
      'Images taguées par SHA poussées sur le registre GitHub, jamais écrasées.',
      'SHA-tagged images pushed to the GitHub registry, never overwritten.',
    ),
    tools: ['ghcr.io', 'SHA', 'SBOM'],
  },
  {
    phase: copy('CD', 'CD'),
    title: copy('Déployer', 'Deploy'),
    description: copy(
      'SSH par clé, compose pull, redémarrage et healthcheck avant validation.',
      'Key-based SSH, compose pull, restart and healthcheck before validation.',
    ),
    tools: ['SSH', 'Compose', 'Healthcheck'],
  },
  {
    phase: copy('CD', 'CD'),
    title: copy('Observer', 'Observe'),
    description: copy(
      'Disponibilité, journaux et retour arrière vers le tag précédent en une commande.',
      'Uptime, logs and rollback to the previous tag in one command.',
    ),
    tools: ['Uptime Kuma', 'Logs', 'Rollback'],
  },
];

const stack = [
  'Astro 5',
  'Tailwind CSS 4',
  'TypeScript',
  'Flask',
  'PostgreSQL',
  'Docker',
  'Caddy',
  'GitHub Actions',
  'Uptime Kuma',
];
---

<BaseLayout title={t('infrastructure.title')} description={t('infrastructure.lead')} lang={lang}>
  <PageHeader
    eyebrow={`06 — ${t('infrastructure.title')}`}
    title={t('infrastructure.title')}
    lead={t('infrastructure.lead')}
  />

  <section class="pb-14 md:pb-20">
    <div class="container-page">
      <h2 class="eyebrow">{t('infrastructure.architecture')}</h2>
      <div class="mt-6">
        <ArchitectureDiagram layers={layers} label={t('infrastructure.architecture')} />
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-surface">
    <div class="container-page section">
      <div class="max-w-2xl">
        <h2 class="eyebrow">{t('infrastructure.pipeline')}</h2>
        <p class="mt-4 text-lead text-muted">{t('infrastructure.pipelineLead')}</p>
      </div>

      <ol class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-5 lg:gap-6">
        {pipeline.map((step, index) => (
          <li
            class="border-t border-line pt-5"
            data-reveal
            style={`transition-delay: ${index * 60}ms`}
          >
            <div class="flex items-center justify-between gap-3">
              <span class="font-mono text-xs text-accent">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="tag">{step.phase}</span>
            </div>
            <h3 class="mt-3 text-h3 font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.description}</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {step.tools.map((tool) => (
                <li class="font-mono text-[0.66rem] text-muted">{tool}</li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container-page section">
    <h2 class="eyebrow">{t('infrastructure.stack')}</h2>
    <ul class="mt-6 flex flex-wrap gap-2">
      {stack.map((item) => (
        <li class="tag">{item}</li>
      ))}
    </ul>
  </section>
</BaseLayout>
