---
import PageHeader from '@/components/PageHeader.astro';
import { careerItems } from '@/data/career';
import { locales, type Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t('career.title')} description={t('career.lead')} lang={lang}>
  <PageHeader
    eyebrow={`03 — ${t('nav.career')}`}
    title={t('career.title')}
    lead={t('career.lead')}
  />

  <section class="pb-20 md:pb-28">
    <div class="container-page">
      <ol class="timeline" aria-label={t('career.timelineLabel')}>
        {careerItems.map((item, index) => (
          <li class="timeline__item" data-reveal style={`transition-delay: ${index * 60}ms`}>
            <div class="flex flex-wrap items-center gap-3">
              <span class="font-mono text-xs tracking-[0.1em] text-muted">{item.period}</span>
              <span class="tag">{t(`career.${item.kind}`)}</span>
              {item.current && (
                <span class="inline-flex items-center gap-2 text-xs text-muted">
                  <span class="status-dot" aria-hidden="true"></span>
                  {t('career.present')}
                </span>
              )}
            </div>

            <h2 class="mt-2 text-h3 font-semibold">{item.title[lang]}</h2>
            <p class="mt-1 text-sm text-muted">
              {item.organization} · {item.location}
            </p>
            <p class="mt-3 max-w-[62ch] text-sm leading-relaxed text-muted">
              {item.description[lang]}
            </p>

            {item.tags && item.tags.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-2" aria-label="Technologies">
                {item.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .timeline {
    display: grid;
    gap: 2.75rem;
    margin: 0;
    padding-left: 1.75rem;
    border-left: 1px solid var(--c-line);
    list-style: none;
  }

  .timeline__item {
    position: relative;
  }

  .timeline__item::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: calc(-1.75rem - 5px);
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--c-accent);
    box-shadow: 0 0 0 4px var(--c-canvas);
  }
</style>
